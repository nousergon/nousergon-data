{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nousergon-data/contracts/metron_macro.schema.json",
  "title": "Metron macro indicators (market_data/macro/latest.json, schema_version 2)",
  "description": "Producer: collectors/metron_market_data.py::collect_macro (MACRO_SCHEMA_VERSION). v2 additive `next_release` + `release_events` (metron-ops#49). Consumer: Metron portfolio_analytics/macro/spine_source.py, api/services/*.py (Macro + Calendar pages). Plan §3 boundary table row 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "series", "next_release", "release_events"],
  "properties": {
    "schema_version": {"const": 2},
    "as_of": {"type": "string", "format": "date"},
    "series": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [{"type": "string", "format": "date"}, {"type": "number"}]
        }
      }
    },
    "next_release": {"type": "object", "additionalProperties": {"type": "string", "format": "date"}},
    "release_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "kind", "series_id", "label"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "kind": {"type": "string"},
          "series_id": {"type": "string"},
          "label": {"type": "string"}
        }
      }
    }
  }
}
