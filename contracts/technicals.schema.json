{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metron Technicals (EOD)",
  "description": "market_data/technicals/latest.json \u2014 per-held-symbol EOD technical indicators, written by collectors/metron_market_data.py::collect_technicals from close_history (no new fetch). PRODUCER TEST: tests/test_technical_rating_contracts.py. v3 (metron-ops#293) is additive: each symbol MAY carry a `rating` object (omitted, never fabricated, when no vote is computable) alongside the pre-existing v1/v2 fields. v4 (metron-ops#297) is additive: `rating.rating_version` names the rule-set version that produced the rating.",
  "type": "object",
  "required": [
    "schema_version",
    "as_of",
    "source",
    "technicals"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 4
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-provenance": true
    },
    "source": {
      "type": "string",
      "const": "computed"
    },
    "technicals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rsi_14": {
            "type": [
              "number",
              "null"
            ]
          },
          "macd_hist": {
            "type": [
              "number",
              "null"
            ]
          },
          "ma_50": {
            "type": [
              "number",
              "null"
            ]
          },
          "ma_200": {
            "type": [
              "number",
              "null"
            ]
          },
          "pct_to_ma_50": {
            "type": [
              "number",
              "null"
            ]
          },
          "pct_to_ma_200": {
            "type": [
              "number",
              "null"
            ]
          },
          "high_52w": {
            "type": [
              "number",
              "null"
            ]
          },
          "low_52w": {
            "type": [
              "number",
              "null"
            ]
          },
          "pct_in_52w_range": {
            "type": [
              "number",
              "null"
            ]
          },
          "pct_from_52wk_high": {
            "type": [
              "number",
              "null"
            ]
          },
          "mom_20d": {
            "type": [
              "number",
              "null"
            ]
          },
          "mom_60d": {
            "type": [
              "number",
              "null"
            ]
          },
          "rating": {
            "description": "Additive, v3 (metron-ops#293); `rating_version` additive as of v4 (metron-ops#297). Present only when compute_technical_rating found at least one computable vote \u2014 see technical_rating.schema.json for the shared shape.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "score",
              "label",
              "ma_score",
              "osc_score",
              "n_buy",
              "n_neutral",
              "n_sell",
              "n_votes",
              "rating_version"
            ],
            "properties": {
              "score": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "label": {
                "type": "string",
                "enum": [
                  "Strong Sell",
                  "Sell",
                  "Neutral",
                  "Buy",
                  "Strong Buy"
                ]
              },
              "ma_score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -1,
                "maximum": 1
              },
              "osc_score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -1,
                "maximum": 1
              },
              "n_buy": {
                "type": "integer",
                "minimum": 0
              },
              "n_neutral": {
                "type": "integer",
                "minimum": 0
              },
              "n_sell": {
                "type": "integer",
                "minimum": 0
              },
              "n_votes": {
                "type": "integer",
                "minimum": 1
              },
              "rating_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "x-key-pattern": "market_data/technicals/latest.json"
}
