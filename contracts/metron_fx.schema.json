{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nousergon-data/contracts/metron_fx.schema.json",
  "title": "Metron FX rates (market_data/fx/{run_date,latest}.json, schema_version 1)",
  "description": "Producer: collectors/metron_market_data.py::collect_metron_data (FX_SCHEMA_VERSION). Consumer: Metron portfolio_analytics currency conversion. Plan \u00a73 boundary table row 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "base",
    "rates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "x-provenance": true
    },
    "base": {
      "type": "string",
      "const": "USD"
    },
    "rates": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  },
  "x-key-pattern": [
    "market_data/fx/{date}.json",
    "market_data/fx/latest.json"
  ],
  "x-comparison-class": "vendor_live",
  "x-vendor-live": {
    "value_band": {
      "relative": 0.005,
      "absolute": 0.0
    },
    "coverage_floor": 0.99
  }
}
