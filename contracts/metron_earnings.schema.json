{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nousergon-data/contracts/metron_earnings.schema.json",
  "title": "Metron earnings dates (market_data/earnings/latest.json, schema_version 1)",
  "description": "Producer: collectors/metron_market_data.py::collect_reference (EARNINGS_SCHEMA_VERSION). Consumer: Metron api/services/*.py (Calendar page). Plan \u00a73 boundary table row 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "earnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "x-provenance": true
    },
    "earnings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "date"
      }
    }
  },
  "x-key-pattern": "market_data/earnings/latest.json",
  "x-comparison-class": "vendor_live",
  "x-vendor-live": {
    "value_band": {
      "relative": 0.0,
      "absolute": 0.0
    },
    "coverage_floor": 0.98
  },
  "x-pit": {
    "event_time": "as_of",
    "available_at_basis": "collection_time",
    "admissible_when": "available_at_or_before_decision",
    "revisions": "overwritten",
    "rule": "Earnings calendar as read by the run; available_at is that run's data_pit stamp. latest.json is rewritten each run.",
    "tracker": "alpha-engine-config-I12567"
  }
}
