{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nousergon-data/contracts/edgar_pit_fundamentals_session.schema.json",
  "title": "EDGAR point-in-time fundamentals, one session (schema_version 1)",
  "description": "One row of fundamentals_pit/edgar/v1/sessions/{YYYY-MM-DD}.parquet. Producer: collectors/edgar_pit_fundamentals.py. Consumer: crucible/data/point_in_time.py::FilingDatePointInTimeSource. The file labelled L uses only facts with EDGAR filed <= L and the close of session L; it is admissible for a session S only when L < S. alpha-engine-config-I10733.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticker", "cik", "knowledge_date", "schema_version", "latest_filed", "latest_accession",
    "roe", "debt_to_equity", "gross_margin", "current_ratio", "pe_ratio", "pb_ratio", "fcf_yield",
    "revenue_growth_3y", "eps_growth_3y", "capex_growth_5y", "payout_ratio",
    "close_raw", "market_cap_raw", "shares_outstanding_raw", "net_income_ttm_raw", "revenue_ttm_raw",
    "gross_profit_ttm_raw", "equity_raw", "total_debt_raw", "assets_current_raw",
    "liabilities_current_raw", "fcf_ttm_raw", "dividends_ttm_raw"
  ],
  "properties": {
    "ticker": {"type": "string", "minLength": 1},
    "cik": {"type": "integer", "minimum": 1},
    "knowledge_date": {"type": "string", "format": "date", "description": "The session label L; equals the key's date."},
    "schema_version": {"const": 1},
    "latest_filed": {"type": "string", "format": "date", "description": "Newest EDGAR filing date used for the row; <= knowledge_date."},
    "latest_accession": {"type": "string", "minLength": 1},
    "roe": {"type": ["number", "null"], "minimum": -1, "maximum": 1, "description": "net income TTM / equity; null when equity <= 0"},
    "debt_to_equity": {"type": ["number", "null"], "minimum": -3, "maximum": 3, "description": "total debt / equity / 2"},
    "gross_margin": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "current_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 3, "description": "current assets / current liabilities / 3"},
    "pe_ratio": {"type": ["number", "null"], "minimum": -3, "maximum": 3, "description": "market cap / net income TTM / 30"},
    "pb_ratio": {"type": ["number", "null"], "minimum": -3, "maximum": 3, "description": "market cap / equity / 5"},
    "fcf_yield": {"type": ["number", "null"], "minimum": -0.5, "maximum": 0.5},
    "revenue_growth_3y": {"type": ["number", "null"], "minimum": -0.5, "maximum": 1.5},
    "eps_growth_3y": {"type": ["number", "null"], "minimum": -1, "maximum": 2},
    "capex_growth_5y": {"type": ["number", "null"], "minimum": -1, "maximum": 2},
    "payout_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 2},
    "close_raw": {"type": ["number", "null"], "description": "ArcticDB universe Close on L, USD, current split basis"},
    "market_cap_raw": {"type": ["number", "null"], "description": "USD"},
    "shares_outstanding_raw": {"type": ["number", "null"], "description": "shares, current split basis"},
    "net_income_ttm_raw": {"type": ["number", "null"], "description": "USD"},
    "revenue_ttm_raw": {"type": ["number", "null"], "description": "USD"},
    "gross_profit_ttm_raw": {"type": ["number", "null"], "description": "USD"},
    "equity_raw": {"type": ["number", "null"], "description": "USD"},
    "total_debt_raw": {"type": ["number", "null"], "description": "USD"},
    "assets_current_raw": {"type": ["number", "null"], "description": "USD"},
    "liabilities_current_raw": {"type": ["number", "null"], "description": "USD"},
    "fcf_ttm_raw": {"type": ["number", "null"], "description": "USD"},
    "dividends_ttm_raw": {"type": ["number", "null"], "description": "USD"}
  }
}
