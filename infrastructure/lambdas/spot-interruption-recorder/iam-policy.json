{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:711398986525:log-group:/aws/lambda/alpha-engine-spot-interruption-recorder:*"
    },
    {
      "Sid": "ReadCloudTrailEvictionHistory",
      "Effect": "Allow",
      "Action": "cloudtrail:LookupEvents",
      "Resource": "*"
    },
    {
      "Sid": "DescribeInstancesForAttribution",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "WriteInterruptionSeries",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::alpha-engine-research/overseer/interruptions/*"
    },
    {
      "Sid": "HeadObjectForIdempotency",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::alpha-engine-research",
      "Condition": {
        "StringLike": {
          "s3:prefix": "overseer/interruptions/*"
        }
      }
    }
  ]
}
