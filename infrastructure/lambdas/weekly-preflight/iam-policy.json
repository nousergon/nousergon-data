{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadStepFunctionDefinition",
            "Effect": "Allow",
            "Action": "states:DescribeStateMachine",
            "Resource": "arn:aws:states:us-east-1:711398986525:stateMachine:ne-weekly-freshness-pipeline"
        },
        {
            "Sid": "SimulateIAMPolicy",
            "Effect": "Allow",
            "Action": "iam:SimulatePrincipalPolicy",
            "Resource": "*"
        },
        {
            "Sid": "ReadLambdaConfig",
            "Effect": "Allow",
            "Action": "lambda:GetFunctionConfiguration",
            "Resource": "*"
        },
        {
            "Sid": "ReadCloudWatchMetrics",
            "Effect": "Allow",
            "Action": "cloudwatch:GetMetricStatistics",
            "Resource": "*"
        },
        {
            "Sid": "ReadS3Config",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::alpha-engine-research/*"
        },
        {
            "Sid": "ListS3ConfigPrefix",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::alpha-engine-research",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "*"
                    ]
                }
            }
        }
    ]
}
