{
  "Comment": "Nous Ergon data collection (alpha-engine-config-I10739; architecture.d/146). One definition, four state machines in the nousergon-data-collection stack (eod, morning, weekly, daily-heal), each started by its own EventBridge Scheduler schedule with an Input naming the collection, its ordered data-spot-dispatcher workloads, whether it runs only on NYSE trading days, and which audit UNITS (`verify_units`) must each leave a passing `data_run_manifest.v1` for the run. Independent of every Crucible v1 pipeline. FAIL-LOUD by design: unlike the v1 trading SFs' data-spot stages (fail-open so trading continues), data collection has no downstream stage to protect, so a workload failure, a disabled dispatcher, a missing run manifest, a non-ok run, an undeclared-but-promised output or a row count under its floor each FAIL the execution and page.",
  "StartAt": "Init",
  "TimeoutSeconds": 28800,
  "States": {
    "Init": {
      "Type": "Pass",
      "Comment": "Pin the execution start time as the freshness baseline: every verified unit's newest run manifest must have FINISHED at or after it, or the unit left no record of THIS run.",
      "Parameters": {
        "collection.$": "$.collection",
        "workloads.$": "$.workloads",
        "require_trading_day.$": "$.require_trading_day",
        "verify_units.$": "$.verify_units",
        "started_at.$": "$$.Execution.StartTime"
      },
      "Next": "CheckRequireTradingDay"
    },
    "CheckRequireTradingDay": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.require_trading_day",
          "BooleanEquals": true,
          "Next": "TradingDayCheck"
        }
      ],
      "Default": "RunWorkloads"
    },
    "TradingDayCheck": {
      "Type": "Task",
      "Comment": "The dispatcher answers from krepis.trading_calendar for today's America/New_York date. It launches nothing for this action.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${DispatcherFunctionArn}",
        "Payload": {
          "action": "trading-day-check"
        }
      },
      "ResultSelector": {
        "date.$": "$.Payload.trading_day.date",
        "is_trading_day.$": "$.Payload.trading_day.is_trading_day"
      },
      "ResultPath": "$.trading_day",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "IsTradingDay"
    },
    "IsTradingDay": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.trading_day.is_trading_day",
          "BooleanEquals": true,
          "Next": "RunWorkloads"
        }
      ],
      "Default": "NotATradingDay"
    },
    "NotATradingDay": {
      "Type": "Succeed",
      "Comment": "HOLIDAY-SKIPPED terminal state (sf-pipeline-policy 4.1): a distinct, machine-readable success so a scheduled weekday that is an NYSE holiday is never rendered as a missed run."
    },
    "RunWorkloads": {
      "Type": "Map",
      "Comment": "Workloads run strictly in order (MaxConcurrency 1): each append consumes the parquet its predecessor wrote.",
      "ItemsPath": "$.workloads",
      "MaxConcurrency": 1,
      "ItemSelector": {
        "workload.$": "$$.Map.Item.Value",
        "execution_id.$": "$$.Execution.Id",
        "pipeline_role.$": "$.collection",
        "force_on_demand": false,
        "attempts": 0
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "LaunchWorkload",
        "States": {
          "LaunchWorkload": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${DispatcherFunctionArn}",
              "Payload": {
                "workload.$": "$.workload",
                "execution_id.$": "$.execution_id",
                "pipeline_role.$": "$.pipeline_role",
                "force_on_demand.$": "$.force_on_demand"
              }
            },
            "ResultSelector": {
              "data_spot.$": "$.Payload.data_spot"
            },
            "ResultPath": "$.launch",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 10,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.workload_error",
                "Next": "CheckRetryBudget"
              }
            ],
            "Next": "CheckLaunched"
          },
          "CheckLaunched": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.launch.data_spot.launched",
                "BooleanEquals": true,
                "Next": "WaitForWorkload"
              }
            ],
            "Default": "DispatchDisabled"
          },
          "DispatchDisabled": {
            "Type": "Fail",
            "Error": "DataCollectionDispatchDisabled",
            "Cause": "The data-spot dispatcher returned launched=false (DATA_SPOT_DISPATCH_ENABLED=false). A scheduled collection that collects nothing is a failure, never a skip."
          },
          "WaitForWorkload": {
            "Type": "Wait",
            "Seconds": 60,
            "Next": "PollWorkload"
          },
          "PollWorkload": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
            "Parameters": {
              "CommandId.$": "$.launch.data_spot.command_id",
              "InstanceId.$": "$.launch.data_spot.instance_id"
            },
            "ResultSelector": {
              "Status.$": "$.Status",
              "StatusDetails.$": "$.StatusDetails"
            },
            "ResultPath": "$.poll",
            "Retry": [
              {
                "ErrorEquals": [
                  "Ssm.InvocationDoesNotExistException",
                  "Ssm.InvocationDoesNotExist"
                ],
                "IntervalSeconds": 30,
                "MaxAttempts": 10,
                "BackoffRate": 1.5
              },
              {
                "ErrorEquals": ["Ssm.SdkClientException", "Ssm.SsmException"],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.workload_error",
                "Next": "CheckRetryBudget"
              }
            ],
            "Next": "CheckWorkloadStatus"
          },
          "CheckWorkloadStatus": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.poll.Status",
                "StringEquals": "Success",
                "Next": "WorkloadSucceeded"
              },
              {
                "Or": [
                  {"Variable": "$.poll.Status", "StringEquals": "Pending"},
                  {"Variable": "$.poll.Status", "StringEquals": "InProgress"},
                  {"Variable": "$.poll.Status", "StringEquals": "Delayed"}
                ],
                "Next": "WaitForWorkload"
              }
            ],
            "Default": "CheckRetryBudget"
          },
          "CheckRetryBudget": {
            "Type": "Choice",
            "Comment": "One retry, ON-DEMAND — the same budget and shape as the v1 EOD SF's post-interruption retry (2026-07-14): a workload that lost a box does not gamble on spot twice.",
            "Choices": [
              {
                "Variable": "$.attempts",
                "NumericLessThan": 1,
                "Next": "RetryOnDemand"
              }
            ],
            "Default": "WorkloadFailed"
          },
          "RetryOnDemand": {
            "Type": "Pass",
            "Parameters": {
              "workload.$": "$.workload",
              "execution_id.$": "$.execution_id",
              "pipeline_role.$": "$.pipeline_role",
              "force_on_demand": true,
              "attempts.$": "States.MathAdd($.attempts, 1)"
            },
            "Next": "LaunchWorkload"
          },
          "WorkloadFailed": {
            "Type": "Fail",
            "Error": "DataCollectionWorkloadFailed",
            "Cause": "A data-spot workload failed on its on-demand retry. The execution history names the workload, the SSM status and the dispatcher error; the box log is under s3://alpha-engine-research/_ssm_logs/data-spot/<workload>/."
          },
          "WorkloadSucceeded": {
            "Type": "Succeed"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "CheckVerifyUnits"
    },
    "CheckVerifyUnits": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.verify_units[0]",
          "IsPresent": true,
          "Next": "VerifyRunManifests"
        }
      ],
      "Default": "CollectionSucceeded"
    },
    "VerifyRunManifests": {
      "Type": "Task",
      "Comment": "alpha-engine-config-I10787 (plan P-20). The completion claim is the RUN MANIFEST of every unit this machine runs, not a HEAD on two keys: the manifest must exist for this execution, carry status=ok, and list EVERY key the unit's descriptor says it publishes at or above that key's declared rows_out floor. Per-key floor compliance means searching an array of objects by field value, which ASL cannot express (a Map over outputs[] can only assert 'some output exists' — the claim being replaced), so the check is an action on the dispatcher Lambda that already reads this repo's descriptors, exactly as TradingDayCheck is. It launches nothing. FAIL LOUD: a dispatcher error goes to NotifyFailure through the Catch below, and a measured finding goes to one of four distinct named Fail states — there is no edge from here to CollectionSucceeded that is not an affirmative measured pass.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${DispatcherFunctionArn}",
        "Payload": {
          "action": "completion-check",
          "collection.$": "$.collection",
          "units.$": "$.verify_units",
          "started_at.$": "$.started_at"
        }
      },
      "ResultSelector": {
        "ok.$": "$.Payload.completion.ok",
        "failure_mode.$": "$.Payload.completion.failure_mode",
        "summary.$": "$.Payload.completion.summary",
        "findings.$": "$.Payload.completion.findings",
        "units.$": "$.Payload.completion.units"
      },
      "ResultPath": "$.completion",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "CheckCompletion"
    },
    "CheckCompletion": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.completion.ok",
          "BooleanEquals": true,
          "Next": "CollectionSucceeded"
        }
      ],
      "Default": "NotifyCompletionFindings"
    },
    "NotifyCompletionFindings": {
      "Type": "Task",
      "Comment": "Page BEFORE the Fail state so the operator gets the finding list, not just the error name. A publish failure routes on to the same switch: a paging outage must never convert a completion finding into a green run.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertsTopicArn}",
        "Subject": "Nous Ergon data collection COMPLETION CHECK FAILED",
        "Message.$": "States.Format('Data collection {} failed its run-manifest completion check. Execution: {}. Mode: {}. {}', $.collection, $$.Execution.Id, $.completion.failure_mode, $.completion.summary)"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": null,
          "Next": "CompletionFailureMode"
        }
      ],
      "Next": "CompletionFailureMode"
    },
    "CompletionFailureMode": {
      "Type": "Choice",
      "Comment": "Four named failure modes, in the precedence the Lambda applies: a missing manifest explains a missing output, never the reverse. A mode this switch does not know is a Fail of its own — a new mode must never fall through to a pass.",
      "Choices": [
        {
          "Variable": "$.completion.failure_mode",
          "StringEquals": "manifest_missing",
          "Next": "ManifestMissing"
        },
        {
          "Variable": "$.completion.failure_mode",
          "StringEquals": "run_not_ok",
          "Next": "RunNotOk"
        },
        {
          "Variable": "$.completion.failure_mode",
          "StringEquals": "output_missing",
          "Next": "OutputMissing"
        },
        {
          "Variable": "$.completion.failure_mode",
          "StringEquals": "rows_below_floor",
          "Next": "RowsBelowFloor"
        }
      ],
      "Default": "CompletionModeUnknown"
    },
    "ManifestMissing": {
      "Type": "Fail",
      "Error": "DataCollectionManifestMissing",
      "CausePath": "$.completion.summary"
    },
    "RunNotOk": {
      "Type": "Fail",
      "Error": "DataCollectionRunNotOk",
      "CausePath": "$.completion.summary"
    },
    "OutputMissing": {
      "Type": "Fail",
      "Error": "DataCollectionOutputMissing",
      "CausePath": "$.completion.summary"
    },
    "RowsBelowFloor": {
      "Type": "Fail",
      "Error": "DataCollectionRowsBelowFloor",
      "CausePath": "$.completion.summary"
    },
    "CompletionModeUnknown": {
      "Type": "Fail",
      "Error": "DataCollectionCompletionModeUnknown",
      "CausePath": "$.completion.summary"
    },
    "CollectionSucceeded": {
      "Type": "Succeed"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertsTopicArn}",
        "Subject": "Nous Ergon data collection FAILED",
        "Message.$": "States.Format('Data collection {} failed. Execution: {}. Error: {}', $.collection, $$.Execution.Id, States.JsonToString($.error))"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": null,
          "Next": "CollectionFailed"
        }
      ],
      "Next": "CollectionFailed"
    },
    "CollectionFailed": {
      "Type": "Fail",
      "Error": "DataCollectionFailed",
      "Cause": "See the NotifyFailure input in this execution's history for the failing state and error."
    }
  }
}
